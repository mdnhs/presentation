{
  "name": "project-dashboard",
  "private": true,
  "scripts": {
    "setup": "bash backend/scripts/download-pb.sh && npm install && npm --prefix frontend install",
    "dev": "concurrently -k -n pb,web -c blue,magenta \"npm:dev:pb\" \"npm:dev:web\"",
    "dev:pb": "cd backend && ./pocketbase serve --http=127.0.0.1:8090",
    "create-admin": "cd backend && ./pocketbase create-admin",
    "seed": "cd backend && ./pocketbase seed",
    "seed:force": "cd backend && ./pocketbase seed force",
    "wipe": "cd backend && ./pocketbase wipe",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
